# ─── API URL ─────────────────────────────────────────────────────────────────
# HttpApiUrl de infra/shared en tu stage (npx serverless info --stage <stage> --verbose)
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# ─── Cognito ─────────────────────────────────────────────────────────────────
# UserPoolId y UserPoolClientId de los mismos outputs. No son secretos, el cliente no tiene secreto
NEXT_PUBLIC_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Red Talento TP
NEXT_PUBLIC_APP_URL=http://localhost:3000
